# ── Required ──────────────────────────────────────────────────────────────────
# SQLite database path (relative to the backend/ directory)
DATABASE_URL="file:./dev.db"

# ── Default Agent: NVIDIA NIM (required for Default RedGuard Agent) ───────────
NVIDIA_API_KEY=nvapi-...
# Override model (default: nvidia/nemotron-3-ultra-550b-a55b)
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ── Groq (required for: RAG Agent, Code Auditor Agent) ───────────────────────
GROQ_API_KEY=gsk_...
# Override model (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# ── Google Gemini Flash (required for: Gemini Flash Agent) ───────────────────
# Free API key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# ── Ollama — local model server (no key needed, run `ollama serve` first) ────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── Internal services ─────────────────────────────────────────────────────────
# Optional ML classifier for a secondary verdict. Unset = no classifier call.
# Every probe prompt is POSTed to this URL, so only point it at a service you run.
# CLASSIFIER_URL=http://localhost:9000/agent/classify

# Origins allowed to call the API directly from a browser (comma-separated).
# The UI goes through the Next.js /api rewrite and does not need this.
# CORS_ORIGINS=http://localhost:3000

# Legacy proxy target (unused in current web UI)
# LOBSTERTRAP_URL=http://localhost:8080

# ── Notifications (optional) ──────────────────────────────────────────────────
# Slack/Discord webhook URL for critical alerts after each scan
# WEBHOOK_URL=https://hooks.slack.com/services/...
