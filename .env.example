# ── Required ──────────────────────────────────────────────────────────────────
# Used by: default_agent, rag_knowledge_agent, code_auditor_agent, ollama (fallback)
GROQ_API_KEY=
DATABASE_URL=

# ── Agent-specific (optional) ─────────────────────────────────────────────────

# Google Gemini Flash — free API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash   # override model if needed

# Ollama — local model server (run `ollama serve` first)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Groq model override (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# ── Internal services ─────────────────────────────────────────────────────────
CLASSIFIER_ENDPOINT=https://api.mohitchdev.me/agent/classify
LOBSTERTRAP_URL=http://localhost:8080

# ── Notifications ─────────────────────────────────────────────────────────────
# Slack/Discord webhook URL for critical alerts
# WEBHOOK_URL=https://hooks.slack.com/services/...
