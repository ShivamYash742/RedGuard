# ── Required ──────────────────────────────────────────────────────────────────
# SQLite database path (relative to the backend/ directory)
DATABASE_URL="file:./dev.db"

# ── Hosted agents: set only the keys for the agents you scan ─────────────────
# Nemotron-3 Ultra (550B) and Nemotron-3 Super (120B), via NVIDIA NIM.
# The models are fixed in the agent files (backend/scanner_mode/agents/).
NVIDIA_API_KEY=nvapi-...
# GPT OSS 120B and GPT OSS 20B, via Groq.
GROQ_API_KEY=gsk_...

# ── Ollama: local model server, no key (run `ollama serve` first) ────────────
# Used by the Ollama Local Agent (Scanner mode) and Lab mode's Ollama provider.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=granite3.3:2b      # Scanner mode's Ollama agent
# LAB_MODEL=granite3.3:2b         # Lab mode, when an experiment names no model
# SCANNER_TEMPERATURE=0           # Scanner mode's Ollama agent; recorded on each session
# SCANNER_SEED=0                  # same; makes a rerun repeat

# ── Custom agent (backend/scanner_mode/agents/example_custom_agent.py) ───────
# CUSTOM_AGENT_URL=http://localhost:5000/v1/chat/completions
# CUSTOM_AGENT_MODEL=custom-model
# CUSTOM_AGENT_KEY=

# ── Scanning ──────────────────────────────────────────────────────────────────
# Seconds to wait between probes (raise it for strict rate limits).
# SCAN_DELAY_SECONDS=0.5

# Optional ML classifier for a secondary verdict. Unset = no classifier call.
# Every probe prompt is POSTed to this URL, so only point it at a service you run.
# CLASSIFIER_URL=http://localhost:9000/agent/classify

# ── API ───────────────────────────────────────────────────────────────────────
# Origins allowed to call the API (comma-separated). Requests with any other
# Origin header get 403. The default is both UI origins.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Notifications (optional) ──────────────────────────────────────────────────
# Slack/Discord webhook URL for critical alerts after each scan
# WEBHOOK_URL=https://hooks.slack.com/services/...
