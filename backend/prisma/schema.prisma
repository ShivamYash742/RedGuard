datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
  output               = "../.venv/lib64/python3.14/site-packages/prisma"
}

model Session {
  id          String       @id @default(cuid())
  sessionId   String       @unique @map("session_id")
  agentId     String?      @map("agent_id")
  agentName   String?      @map("agent_name")
  startedAt   DateTime     @default(now()) @map("started_at")
  finishedAt  DateTime?    @map("finished_at")
  totalProbes Int          @default(0) @map("total_probes")
  blocked     Int          @default(0)
  allowed     Int          @default(0)
  mismatches  Int          @default(0)
  blockRate   Float        @default(0) @map("block_rate")
  status      String       @default("RUNNING")
  events      ProbeEvent[]
  report      Report?
  policy      PolicySnapshot?

  @@map("sessions")
}


model ProbeEvent {
  id                   String   @id @default(cuid())
  session              Session  @relation(fields: [sessionId], references: [id])
  sessionId            String   @map("session_id")
  timestamp            DateTime @default(now())
  category             String                          
  probeIndex           Int      @map("probe_index")    
  promptText           String   @map("prompt_text")
  promptHash           String   @map("prompt_hash")

  regexVerdict         String   @map("regex_verdict")  
  regexRiskScore       Float    @map("regex_risk_score")
  regexMetadata        String   @map("regex_metadata") 
  matchedRule          String?  @map("matched_rule")   

  classifierAvailable  Boolean  @default(true) @map("classifier_available")
  classifierVerdict    String?  @map("classifier_verdict")  
  classifierScore      Float?   @map("classifier_score")
  classifierResult     String?  @map("classifier_result")

  status               String   
  mismatch             Boolean  @default(false)
  declaredIntent       String   @map("declared_intent")
  detectedIntent       String   @map("detected_intent")

  responseExcerpt      String?  @map("response_excerpt")
  eventHash            String   @map("event_hash")

  @@map("probe_events")
}

model Report {
  id              String   @id @default(cuid())
  session         Session  @relation(fields: [sessionId], references: [id])
  sessionId       String   @unique @map("session_id")
  generatedAt     DateTime @default(now()) @map("generated_at")
  reportJson      String   @map("report_json")
  reportMarkdown  String   @map("report_markdown")
  manifestSha256  String   @map("manifest_sha256")

  @@map("reports")
}

model PolicySnapshot {
  id          String   @id @default(cuid())
  session     Session  @relation(fields: [sessionId], references: [id])
  sessionId   String   @unique @map("session_id")
  snapshotAt  DateTime @default(now()) @map("snapshot_at")
  policyYaml  String   @map("policy_yaml")
  policyName  String   @map("policy_name")
  version     String

  @@map("policy_snapshots")
}

model CustomProbe {
  id          String   @id @default(cuid())
  category    String
  promptText  String   @map("prompt_text")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("custom_probes")
}

// ── Multi-Agent Lab (Mode B) ──────────────────────────────────────────────────
// These models are entirely separate from Mode A (Session / ProbeEvent).
// No existing table is modified.

model Experiment {
  id             String   @id @default(cuid())
  name           String
  mode           String   @default("multi_agent") // "multi_agent"
  topologyConfig String   @map("topology_config") // JSON
  ceeSnapshotId  String   @map("cee_snapshot_id")
  modelConfig    String   @map("model_config")    // JSON
  probeIds       String   @map("probe_ids")       // JSON array of v3 attack case IDs
  manifestJson   String   @map("manifest_json")   // Full reproducibility manifest
  createdAt      DateTime @default(now()) @map("created_at")
  runs           Run[]

  @@map("experiments")
}

model Run {
  id              String       @id @default(cuid())
  experiment      Experiment   @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  experimentId    String       @map("experiment_id")
  attackCaseId    String?      @map("attack_case_id") // v3 attack case ID (null = generic baseline)
  runNumber       Int          @map("run_number")
  isCleanBaseline Boolean      @default(false) @map("is_clean_baseline")
  status          String       @default("pending") // "pending"|"running"|"completed"|"failed"|"stopped"
  startedAt       DateTime     @default(now()) @map("started_at")
  finishedAt      DateTime?    @map("finished_at")
  verdictJson     String?      @map("verdict_json")  // JSON: orthogonal verdict + evidence bundle
  metricsJson     String?      @map("metrics_json")  // JSON: TDS, depth, coverage, blast_radius
  events          TraceEvent[]

  @@index([experimentId, runNumber])
  @@index([experimentId, attackCaseId])
  @@map("runs")
}

model TraceEvent {
  id            String   @id @default(cuid())
  run           Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId         String   @map("run_id")
  step          Int                            // Sequential step within run (gapless)
  timestamp     DateTime @default(now())
  agentId       String?  @map("agent_id")     // null for system/orchestrator events
  eventType     String   @map("event_type")   // Controlled vocabulary
  tool          String?
  arguments     String?                        // JSON
  result        String?
  authorized    Boolean?
  sourceEventId String?  @map("source_event_id") // Observed provenance link
  contentTag    String   @default("system") @map("content_tag")
  risk          String   @default("none")
  metadata      String?                        // JSON

  @@index([runId, step])
  @@index([runId, eventType])
  @@index([runId, agentId])
  @@map("trace_events")
}
