datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

model Session {
  id          String       @id @default(cuid())
  sessionId   String       @unique @map("session_id")
  agentId     String?      @map("agent_id")
  agentName   String?      @map("agent_name")
  startedAt   DateTime     @default(now()) @map("started_at")
  finishedAt  DateTime?    @map("finished_at")
  totalProbes Int          @default(0) @map("total_probes")
  blocked     Int          @default(0)
  allowed     Int          @default(0)
  mismatches  Int          @default(0)
  blockRate   Float        @default(0) @map("block_rate")
  status      String       @default("RUNNING")

  // Tiered outcome (null benchmarkVersion = legacy row scored BLOCKED/ALLOWED).
  // blocked = filtered + refused + ignored, allowed = compromised.
  benchmarkVersion    String? @map("benchmark_version")
  promptMode          String? @map("prompt_mode")
  filtered            Int     @default(0)
  refused             Int     @default(0)
  ignored             Int     @default(0)
  compromised         Int     @default(0)
  modelCompromised    Int     @default(0) @map("model_compromised")
  controlsOverRefused Int     @default(0) @map("controls_over_refused")
  controlsUnclear     Int     @default(0) @map("controls_unclear")
  policySha256        String? @map("policy_sha256")
  manifestSha256      String? @map("manifest_sha256")  // digest of the frozen files and probe sets (scanner_mode/manifest.py)
  modelConfig         String? @map("model_config")  // JSON: provider, model, temperature, seed, scaffold
  noAnswer            Int     @default(0) @map("no_answer")
  controlsNoAnswer    Int     @default(0) @map("controls_no_answer")
  events      ProbeEvent[]
  report      Report?
  policy      PolicySnapshot?

  @@map("sessions")
}


model ProbeEvent {
  id                   String   @id @default(cuid())
  session              Session  @relation(fields: [sessionId], references: [id])
  sessionId            String   @map("session_id")
  timestamp            DateTime @default(now())
  category             String                          
  probeIndex           Int      @map("probe_index")    
  promptText           String   @map("prompt_text")
  promptHash           String   @map("prompt_hash")

  regexVerdict         String   @map("regex_verdict")  
  regexRiskScore       Float    @map("regex_risk_score")
  regexMetadata        String   @map("regex_metadata") 
  matchedRule          String?  @map("matched_rule")   

  classifierAvailable  Boolean  @default(true) @map("classifier_available")
  classifierVerdict    String?  @map("classifier_verdict")  
  classifierScore      Float?   @map("classifier_score")
  classifierResult     String?  @map("classifier_result")

  status               String   // FILTERED | REFUSED | IGNORED | COMPROMISED (controls: FILTERED | OVER_REFUSED | HELPED | UNCLEAR); legacy: BLOCKED | ALLOWED
  modelOutcome         String?  @map("model_outcome")   // what the model did, even when the filter decided the tier
  probeId              String?  @map("probe_id")
  isControl            Boolean  @default(false) @map("is_control")
  scoredBy             String?  @map("scored_by")
  recordedActions      String?  @map("recorded_actions")  // JSON: the action-tool calls the agent made on this probe
  mismatch             Boolean  @default(false)
  declaredIntent       String   @map("declared_intent")
  detectedIntent       String   @map("detected_intent")

  responseExcerpt      String?  @map("response_excerpt")
  eventHash            String   @map("event_hash")

  @@map("probe_events")
}

model Report {
  id              String   @id @default(cuid())
  session         Session  @relation(fields: [sessionId], references: [id])
  sessionId       String   @unique @map("session_id")
  generatedAt     DateTime @default(now()) @map("generated_at")
  reportJson      String   @map("report_json")
  reportMarkdown  String   @map("report_markdown")
  manifestSha256  String   @map("manifest_sha256")

  @@map("reports")
}

model PolicySnapshot {
  id          String   @id @default(cuid())
  session     Session  @relation(fields: [sessionId], references: [id])
  sessionId   String   @unique @map("session_id")
  snapshotAt  DateTime @default(now()) @map("snapshot_at")
  policyYaml  String   @map("policy_yaml")
  policyName  String   @map("policy_name")
  version     String

  @@map("policy_snapshots")
}

model CustomProbe {
  id          String   @id @default(cuid())
  category    String
  promptText  String   @map("prompt_text")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("custom_probes")
}

// ─────────────────────────────────────────────────────────────────────────
// Mode B (Lab) — additive only. Does not touch any model above.
// See MULTI_AGENT_LAB_PLAN.md §6.
// ─────────────────────────────────────────────────────────────────────────

model Experiment {
  id              String   @id @default(cuid())
  name            String
  armKey          String   @map("arm_key")        // clean | attack | attack_validated | attack_permissive_tools
  configJson      String   @map("config_json")    // topology, model, tool auth, validation_mode, repetitions
  versionsJson    String   @map("versions_json")  // all *_VERSION constants, git commit
  createdAt       DateTime @default(now()) @map("created_at")
  runs            LabRun[]

  @@map("lab_experiments")
}

model LabRun {
  id              String     @id @default(cuid())
  experiment      Experiment @relation(fields: [experimentId], references: [id])
  experimentId    String     @map("experiment_id")
  caseId          String     @map("case_id")          // RGM-003
  mode            String                               // CLEAN | ATTACK
  pairId          String     @map("pair_id")           // links CLEAN+ATTACK of one repetition
  baselineRunId   String?    @map("baseline_run_id")   // set on ATTACK rows
  repetitionIndex Int        @map("repetition_index")
  seed            Int?
  status          String                               // RUNNING | COMPLETED | FAILED | INVALID
  invalidReason   String?    @map("invalid_reason")
  startedAt       DateTime   @default(now()) @map("started_at")
  finishedAt      DateTime?  @map("finished_at")
  verdictJson     String?    @map("verdict_json")
  metricsJson     String?    @map("metrics_json")
  ceeBeforeJson   String?    @map("cee_before_json")
  ceeAfterJson    String?    @map("cee_after_json")
  events          TraceEvent[]

  @@index([experimentId, caseId])
  @@index([pairId])
  @@map("lab_runs")
}

model TraceEvent {
  id              String   @id @default(cuid())
  run             LabRun   @relation(fields: [runId], references: [id])
  runId           String   @map("run_id")
  step            Int                                  // monotonic per run, gaps allowed
  timestamp       DateTime @default(now())
  agentId         String?  @map("agent_id")
  category        String                               // system|agent|communication|tool|state|injection|evaluation
  eventType       String   @map("event_type")
  tool            String?
  argumentsJson   String?  @map("arguments_json")
  resultJson      String?  @map("result_json")
  authorized      Boolean?
  sourceEventId   String?  @map("source_event_id")     // primary parent
  derivedFromJson String?  @map("derived_from_json")   // full input set (array of ids)
  contentTag      String?  @map("content_tag")
  risk            Float?
  metadataJson    String?  @map("metadata_json")

  @@index([runId, step])
  @@map("lab_trace_events")
}
