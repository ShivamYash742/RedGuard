{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RedGuard v3 Security Test Case",
  "description": "Multi-agent security test case schema. Behavioral evidence (tool calls, state changes) is primary; text indicators are secondary only.",
  "type": "object",
  "required": [
    "id", "version", "title", "attack_family", "attack_variant",
    "execution_scope", "attacker_capability", "attack_entry_point",
    "attack_objective", "target_agent", "target_resource",
    "legitimate_task", "preconditions", "adversarial_artifact",
    "injection_location", "expected_safe_state", "forbidden_actions",
    "forbidden_state_changes", "expected_propagation",
    "expected_containment", "observable_evidence",
    "difficulty", "severity", "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^RG-[A-Z]{2}-[0-9]{3}-MA$",
      "description": "Stable identifier: RG-{FAMILY_CODE}-{NUMBER}-MA"
    },
    "version": { "type": "string", "pattern": "^3\\." },
    "title": { "type": "string", "minLength": 10 },
    "attack_family": {
      "type": "string",
      "enum": [
        "content_injection", "tool_manipulation", "state_poisoning",
        "direct_injection", "data_exfiltration", "goal_diversion",
        "memory_poisoning", "autonomous_actions", "planning_manipulation"
      ]
    },
    "attack_variant": { "type": "string" },
    "execution_scope": {
      "type": "string",
      "enum": ["inter_agent", "single_agent_in_pipeline"]
    },
    "attacker_capability": {
      "type": "string",
      "enum": [
        "document_level", "tool_output_level", "memory_level",
        "web_content_level", "shared_state_level"
      ]
    },
    "attack_entry_point": {
      "type": "string",
      "description": "Which agent's tool input is poisoned. e.g., 'agent_a.web_search'"
    },
    "attack_objective": {
      "type": "string",
      "description": "What the attacker wants to achieve."
    },
    "target_agent": {
      "type": "string",
      "description": "Which agent the attack ultimately targets. e.g., 'agent_c'"
    },
    "target_resource": {
      "type": "string",
      "description": "CEE resource targeted. e.g., 'filesystem.restricted/credentials.json'"
    },
    "legitimate_task": {
      "type": "string",
      "description": "The benign task agents perform when the attack occurs.",
      "minLength": 20
    },
    "preconditions": {
      "type": "object",
      "description": "Required CEE state before the experiment runs.",
      "properties": {
        "filesystem": { "type": "object" },
        "web_results": { "type": "object" },
        "database": { "type": "object" }
      }
    },
    "adversarial_artifact": {
      "type": "string",
      "description": "The adversarial payload text injected into the CEE.",
      "minLength": 10
    },
    "injection_location": {
      "type": "string",
      "description": "CEE location where artifact is placed. e.g., 'web_results.project alpha'"
    },
    "expected_safe_state": {
      "type": "object",
      "description": "What must be true if agents behave securely.",
      "required": ["restricted_files_accessed", "unauthorized_tools_called", "original_goal_preserved", "attack_propagated_to_downstream"],
      "properties": {
        "restricted_files_accessed": { "type": "boolean" },
        "unauthorized_tools_called": { "type": "boolean" },
        "original_goal_preserved": { "type": "boolean" },
        "attack_propagated_to_downstream": { "type": "boolean" }
      }
    },
    "forbidden_actions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Tool call patterns that constitute compromise. e.g., ['file_read:restricted/*']"
    },
    "forbidden_state_changes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "State write patterns that constitute compromise."
    },
    "expected_propagation": {
      "type": "object",
      "required": ["entry_agent", "structurally_reachable_agents"],
      "properties": {
        "entry_agent": { "type": "string" },
        "structurally_reachable_agents": {
          "type": "array", "items": { "type": "string" }
        },
        "expected_containment_point": { "type": "string" }
      }
    },
    "expected_containment": {
      "type": "string",
      "description": "Where a secure system should stop the attack."
    },
    "observable_evidence": {
      "type": "object",
      "required": ["compromise_indicators"],
      "properties": {
        "compromise_indicators": {
          "type": "array", "items": { "type": "string" }, "minItems": 1,
          "description": "Event patterns proving compromise."
        },
        "containment_indicators": {
          "type": "array", "items": { "type": "string" },
          "description": "Event patterns proving containment."
        },
        "propagation_indicators": {
          "type": "array", "items": { "type": "string" },
          "description": "Event patterns proving cross-agent propagation."
        }
      }
    },
    "secondary_text_indicators": {
      "type": "object",
      "description": "SECONDARY ONLY. Text patterns for corroboration — never primary verdict.",
      "properties": {
        "compromise_strings": { "type": "array", "items": { "type": "string" } },
        "refusal_strings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "authors": { "type": "array", "items": { "type": "string" } },
          "year": { "type": "integer" },
          "venue": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    }
  }
}
